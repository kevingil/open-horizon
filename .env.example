# Copy to .env (gitignored) and fill in values as needed.

# --- Backends ---------------------------------------------------------------
# Policy: "static" (stub) or "claude" (real API).
RL_POLICY_BACKEND=static
# Artifact store: "memory" or "sqlite".
RL_STORE_BACKEND=memory
# Environment: "simulated" or "repo".
RL_ENV_BACKEND=simulated

# --- Claude -----------------------------------------------------------------
RL_ANTHROPIC_API_KEY=
RL_CLAUDE_MODEL=claude-haiku-4-5
RL_CLAUDE_MAX_OUTPUT_TOKENS=2048
RL_CLAUDE_MAX_RETRIES=3

# --- Repo sandbox -----------------------------------------------------------
RL_WORKSPACE_ROOT=.
RL_ARTIFACTS_DIR=./artifacts
RL_ENV_COMMAND_TIMEOUT_S=10
RL_ENV_MAX_OUTPUT_BYTES=16384

# --- Budgets & concurrency --------------------------------------------------
RL_MAX_PARALLEL_ROLLOUTS=4
RL_MAX_TOKENS_PER_RUN=100000

# --- Observability ----------------------------------------------------------
RL_LOG_LEVEL=INFO
RL_LOG_JSON=false

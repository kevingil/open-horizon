# Copy to .env (gitignored) and fill in values as needed.
# All keys are read by the Rust control plane (`horizon serve`) with the
# RL_ prefix; the Python bridge receives what it needs per request.

# --- Server ---------------------------------------------------------------
RL_HOST=127.0.0.1
RL_PORT=8000
# Artifact store: "memory" (in-memory SQLite) or "sqlite" (artifacts/runs.db).
# Jobs and the event log live in the same database.
RL_STORE_BACKEND=sqlite
# Environment: "verifiers" (default) or "repo".
#   verifiers: the Python bridge delegates the multi-turn loop to the
#              verifiers framework (its rubric supplies the reward).
#              Requires `pip install -e 'python[envs]'`.
#   repo:      the Rust rollout loop against a sandboxed snapshot of the
#              workspace. Use when verifiers can't help (e.g. "agent fixes a
#              real bug in this checkout").
RL_ENV_BACKEND=verifiers

# --- LLM (OpenAI-compatible) ------------------------------------------------
RL_LLM_API_KEY=
RL_LLM_BASE_URL=https://api.openai.com/v1
RL_LLM_MODEL=gpt-5.4-mini
# Local SGLang (sglang:* prefix marks $0 cost; scripts/serve_sglang.sh starts it):
# RL_LLM_API_KEY=not-needed
# RL_LLM_BASE_URL=http://127.0.0.1:30000/v1
# RL_LLM_MODEL=sglang:Qwen/Qwen3-8B
# Local vLLM / Ollama / Anthropic-via-compat work the same way; see README.
RL_LLM_MAX_OUTPUT_TOKENS=2048
RL_LLM_MAX_RETRIES=3
# Named profiles (JSON). When set, RolloutRequest.policy_profile picks one.
# RL_POLICY_PROFILES={"oai": {"base_url": "https://api.openai.com/v1", "model": "gpt-5.4-mini", "api_key_env": "OPENAI_API_KEY", "routes_to": "repo"}}
# RL_DEFAULT_POLICY_PROFILE=oai

# --- Repo sandbox -----------------------------------------------------------
RL_WORKSPACE_ROOT=.
RL_ARTIFACTS_DIR=./artifacts
RL_ENV_COMMAND_TIMEOUT_S=10
RL_ENV_MAX_OUTPUT_BYTES=16384
# "none" (host subprocess, kill-on-timeout) or "docker" (falls back to none).
RL_ENV_SANDBOX=none
RL_SANDBOX_IMAGE=python:3.11-slim

# --- Budgets, concurrency, jobs --------------------------------------------
RL_MAX_PARALLEL_ROLLOUTS=4
RL_MAX_TOKENS_PER_RUN=100000
RL_DAILY_BUDGET_USD=5.0
RL_BUDGET_WINDOW_HOURS=24
# Job leases: a worker that dies leaves its lease to expire; another
# worker (or the same one after restart) picks the job up.
RL_JOB_LEASE_SECS=30
RL_JOB_MAX_ATTEMPTS=3
# RL_WORKER_ID=worker-a

# --- verifiers env backend (RL_ENV_BACKEND=verifiers) -----------------------
RL_VERIFIERS_ENV_ID=vf-math
# RL_VERIFIERS_ENV_ARGS={"max_recursion": 4}
RL_VERIFIERS_MAX_CONCURRENT=4
# RL_VERIFIERS_ROLLOUT_TIMEOUT_S=300

# --- Python bridge ----------------------------------------------------------
# Interpreter used to spawn `python -m horizon_bridge.worker`. Point it at
# a venv with the extras you need ([envs], [train], [prime-rl]).
RL_BRIDGE_PYTHON=python
# RL_BRIDGE_SRC=./python
# Hard cap on a bridge training call (0 = none).
RL_BRIDGE_TIMEOUT_S=0

# --- Training ---------------------------------------------------------------
# stub (Rust, deterministic, no ML deps), grpo (bridge), or prime-rl (bridge).
RL_TRAINER_BACKEND=stub
RL_ADAPTERS_DIR=./artifacts/adapters
RL_TRAIN_STEP_DELAY_S=0
RL_GRPO_BASE_MODEL=Qwen/Qwen3-0.6B
RL_PRIME_RL_BASE_MODEL=Qwen/Qwen3-8B
RL_PRIME_RL_CLI=prime-rl
# RL_PRIME_RL_CONFIG_TEMPLATE=./configs/prime-rl.toml
# Per-turn token recorder for the repo path: "null" or "tokenized"
# (tokenized calls the bridge's HF tokenizer; needs [train]).
RL_TRAINING_RECORDER=null
RL_RECORDER_TOKENIZER=Qwen/Qwen3-0.6B

# --- Horizon scheduler ------------------------------------------------------
RL_ROUND_SCHEDULER=fixed
RL_ROUND_SCHEDULER_DEFAULT_HORIZON=6
# RL_ROUND_SCHEDULER=scaling
# RL_SCALING_HORIZON_START=4
# RL_SCALING_HORIZON_END=16
# RL_SCALING_RAMP_STEPS=100
# RL_SCALING_MODE=linear

# --- SGLang LoRA hot-reload sidecar -----------------------------------------
# RL_SGLANG_ADMIN_URL=http://127.0.0.1:30000
# RL_SGLANG_AUTOLOAD_LORA=true

# --- Observability ----------------------------------------------------------
RL_LOG_LEVEL=INFO
RL_LOG_JSON=false
# RL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Copy to .env (gitignored) and fill in values as needed.

# --- Backends ---------------------------------------------------------------
# Policy: "static" (stub) or "openai" (any OpenAI-compat endpoint).
RL_POLICY_BACKEND=static
# Artifact store: "memory" or "sqlite".
RL_STORE_BACKEND=memory
# Environment: "verifiers" (default) or "repo".
#   verifiers: delegate the multi-turn rollout loop to the verifiers
#              framework (its rubric replaces CompositeRewardPipeline).
#              Requires `pip install -e .[envs]`.
#   repo:      in-house tool-call loop against a sandboxed tempdir
#              snapshot of the workspace. Use when verifiers can't help
#              (e.g. "agent fixes a real bug in this checkout").
RL_ENV_BACKEND=verifiers

# --- LLM (OpenAI-compatible) ------------------------------------------------
# OpenAI proper. gpt-5.4-mini is the current cheap+capable default
# ($0.75/$4.50 per MTok); gpt-4.1-nano is the absolute floor.
RL_LLM_API_KEY=
RL_LLM_BASE_URL=https://api.openai.com/v1
RL_LLM_MODEL=gpt-5.4-mini

# Local vLLM (no key needed; pricing is treated as $0 with vllm:* prefix):
# RL_LLM_API_KEY=not-needed
# RL_LLM_BASE_URL=http://127.0.0.1:8000/v1
# RL_LLM_MODEL=vllm:Qwen/Qwen3-8B

# Local SGLang (drop-in OpenAI-compat; sglang:* prefix marks $0 cost):
#   scripts/serve_sglang.sh starts the server.
# RL_LLM_API_KEY=not-needed
# RL_LLM_BASE_URL=http://127.0.0.1:30000/v1
# RL_LLM_MODEL=sglang:Qwen/Qwen3-8B
# To route to a hot-mounted LoRA, launch SGLang with --lora-paths
# adapter-aaa=$RL_ADAPTERS_DIR/adapter-aaa and set:
# RL_LLM_MODEL=sglang:adapter-aaa

# Ollama:
# RL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# RL_LLM_MODEL=ollama:qwen3:8b

# Anthropic via OpenAI-compat:
# RL_LLM_API_KEY=sk-ant-...
# RL_LLM_BASE_URL=https://api.anthropic.com/v1/
# RL_LLM_MODEL=claude-haiku-4-5

RL_LLM_MAX_OUTPUT_TOKENS=2048
RL_LLM_MAX_RETRIES=3

# --- Repo sandbox -----------------------------------------------------------
RL_WORKSPACE_ROOT=.
RL_ARTIFACTS_DIR=./artifacts
RL_ENV_COMMAND_TIMEOUT_S=10
RL_ENV_MAX_OUTPUT_BYTES=16384
# Sandbox for tool commands: "none" or "docker" (auto-falls-back to none).
RL_ENV_SANDBOX=none
RL_SANDBOX_IMAGE=python:3.11-slim

# --- Budgets & concurrency --------------------------------------------------
RL_MAX_PARALLEL_ROLLOUTS=4
RL_MAX_TOKENS_PER_RUN=100000
RL_DAILY_BUDGET_USD=5.0
RL_BUDGET_WINDOW_HOURS=24

# --- verifiers env backend (RL_ENV_BACKEND=verifiers) -----------------------
# Hub envs (`vf-math`, `opencode/...`, `rlm`, ...) or local installs.
RL_VERIFIERS_ENV_ID=vf-math
# JSON dict forwarded to vf.load_environment(env_id, **env_args):
# RL_VERIFIERS_ENV_ARGS={"max_recursion": 4}
RL_VERIFIERS_MAX_CONCURRENT=4
# Wallclock cap per rollout (seconds). Empty/unset = no cap.
# RL_VERIFIERS_ROLLOUT_TIMEOUT_S=300
#
# Long-horizon envs (rlm, opencode/*, ...) chew through tokens. When
# you run them, raise the per-run cap, lift the rollout timeout, and
# pass env-specific knobs through verifiers_env_args:
# RL_VERIFIERS_ENV_ID=rlm
# RL_VERIFIERS_ENV_ARGS={"max_recursion_depth": 6, "scratchpad_tokens": 8000}
# RL_VERIFIERS_ROLLOUT_TIMEOUT_S=600
# RL_MAX_TOKENS_PER_RUN=400000

# --- Training ---------------------------------------------------------------
# stub: deterministic fake trainer (default; no ML deps).
# grpo: real GRPO-lite LoRA training; requires `pip install -e .[train]`.
RL_TRAINER_BACKEND=stub
RL_TRAINING_STORE_BACKEND=memory
RL_ADAPTERS_DIR=./artifacts/adapters
RL_TRAIN_STEP_DELAY_S=0
# Only consulted when RL_TRAINER_BACKEND=grpo:
RL_GRPO_BASE_MODEL=Qwen/Qwen3-0.6B

# --- SGLang LoRA hot-reload sidecar -----------------------------------------
# When set and autoload is on, every newly published adapter gets hot-loaded
# into the running SGLang server so `RL_LLM_MODEL=sglang:<adapter_id>` starts
# routing to it immediately - no server restart needed.
# RL_SGLANG_ADMIN_URL=http://127.0.0.1:30000
# RL_SGLANG_AUTOLOAD_LORA=true

# --- Observability ----------------------------------------------------------
RL_LOG_LEVEL=INFO
RL_LOG_JSON=false
